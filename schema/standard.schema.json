{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GRobertsDuyile/ksb-diff/schema/standard.schema.json",
  "title": "Apprenticeship standard and assessment plan, one version",
  "type": "object",
  "required": ["schemaVersion", "standard", "ksbs", "methods"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "standard": {
      "type": "object",
      "required": ["reference", "title", "level", "standardVersion", "assessmentPlanVersion", "publisher", "licence"],
      "additionalProperties": false,
      "properties": {
        "reference": { "type": "string", "pattern": "^ST[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 2, "maximum": 7 },
        "standardVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "assessmentPlanVersion": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "sourceUrl": {
          "type": "object",
          "required": ["standard", "assessmentPlan"],
          "additionalProperties": false,
          "properties": {
            "standard": { "type": "string", "pattern": "^https://" },
            "assessmentPlan": { "type": "string", "pattern": "^https://" }
          }
        },
        "checkedAgainstSource": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "ksbs": {
      "type": "object",
      "propertyNames": { "pattern": "^[KSB][0-9]+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "ksbs", "descriptors"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "format": { "type": "string" },
          "ksbs": { "type": "array", "items": { "type": "string", "pattern": "^[KSB][0-9]+$" } },
          "descriptors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "grade", "ksbs", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^M[0-9]+-[PMD][0-9]{2}$" },
                "grade": { "enum": ["pass", "merit", "distinction"] },
                "ksbs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[KSB][0-9]+$" } },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "gradingRules": {
      "type": "object",
      "required": ["methodGrades", "methodCriteria", "overallGrades", "overallStatements", "overallTable"],
      "additionalProperties": false,
      "properties": {
        "methodGrades": {
          "type": "object",
          "propertyNames": { "pattern": "^M[0-9]+$" },
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "methodCriteria": {
          "type": "object",
          "propertyNames": { "pattern": "^M[0-9]+$" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "enum": ["fail", "pass", "merit", "distinction"] },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "overallGrades": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "overallStatements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "overallTable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["overall"],
            "propertyNames": { "pattern": "^(M[0-9]+|overall)$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "resitStatements": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
